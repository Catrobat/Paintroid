    <string name="help_content_eraser">Rasmning qismlarini xuddi oʻchirgich bilan oʻchiring.</string>
    <string name="help_content_brush">Rang yoki moʻyqalam oʻlchamini oʻzgartirish uchun pastki paneldagi belgilarga bosing.</string>
    <string name="help_content_watercolor">Moʻyqalamga oʻxshaydi, lekin akvarel effekti bilan. Moʻyqalam kuchini rang menyusidagi slayder orqali ham oʻzgartirishingiz mumkin.</string>
    <string name="help_content_eyedropper">Rang tanlash uchun rasmga bosing.</string>
    <string name="help_content_undo">Oldingi amalni bekor qilish uchun bosing.</string>
    <string name="help_content_redo">Bekor qilingan amalni qaytarish uchun bosing.</string>
    <string name="help_content_fill">Sohani tanlangan rang bilan boʻyash uchun rasmga bosing.</string>
    <string name="help_content_cursor">Kursorni chizmoqchi boʻlgan joyga qoʻying. Kursorni yoqish uchun bosing. Chizish uchun barmogʻingizni suring. Oʻchirish uchun yana bosing.</string>
    <string name="help_content_transform">Rasmni buring, aylantiring, qirqing yoki oʻlchamini oʻzgartiring.</string>
    <string name="help_content_clipboard">Toʻrtburchakni muhrlamoqchi boʻlgan sohani qoplaydigan qilib suring va oʻlchamini oʻzgartiring. Sohani tanlash uchun Nusxa olish yoki Kesib olish tugmasini bosing. Uni suring, soʻng muhrlash uchun Joylash tugmasini bosing.</string>
    <string name="help_content_import_png">Galereyadan rasmni buferga import qiling.</string>
    <string name="help_content_line">Toʻgʻri chiziq chizing.</string>
    <string name="help_content_text">Matn yozing va uni formatlang. Soʻng matn maydoni oʻlchamini oʻzgartiring. Matnni rasmga qoʻyish uchun belgiga bosing.</string>
    <string name="help_content_shape">Shaklni tanlang va uni qoʻyish uchun belgiga bosing.</string>
    <string name="help_content_layer">Yangi qatlamlar yarating yoki mavjudlarini oʻzgartiring.</string>
    <string name="help_content_color_chooser">Rangni tanlang yoki sozlang.</string>
    <string name="help_content_hand">Kanvasni surish uchun barmogʻingizni suring.</string>
    <string name="help_content_spray_can">Sprey naqshini yaratish uchun barmogʻingizni rasm ustida suring.</string>
    <string name="help_content_smudge">Rasmdagi turli chizmalarni surtish uchun barmogʻingizni ular ustida suring.</string>
    <string name="help_content_clip">Oʻchirilmasligi kerak boʻlgan sohani belgilang. Undan tashqaridagi hamma narsa olib tashlanadi.</string>
