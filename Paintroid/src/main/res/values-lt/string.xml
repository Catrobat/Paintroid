    <string name="pocketpaint_jpg_message_dialog">Užima <b>mažiausiai vietos</b>. <b>Skaidrumas neišsaugomas</b>.</string>
    <string name="pocketpaint_png_message_dialog">Glaudinimas be nuostolių. Skaidrumas išsaugomas.</string>
    <string name="pocketpaint_ora_message_dialog">Šis formatas išsaugo <b>sluoksnius</b>. <b>Jį galima atidaryti programomis, palaikančiomis OpenRaster formatą.</b></string>
    <string name="pocketpaint_catrobat_message_dialog">Pocket Paint nuosavas paveikslėlių formatas. Šis formatas išsaugo komandas ir sluoksnius.</string>
    <string name="permission_info_external_storage_text">Kad veiktų tinkamai, programai reikia prašomo leidimo. Kad galėtų išsaugoti paveikslėlius vietinėje atmintyje, programai reikia skaitymo ir rašymo prieigos prie jos.</string>
    <string name="permission_info_permanent_denial_text">Kad veiktų tinkamai, programai reikia prašomo leidimo. Kad galėtų išsaugoti paveikslėlius vietinėje atmintyje, programai reikia skaitymo ir rašymo prieigos prie jos. Kadangi atmetėte leidimą pasirinkę „Daugiau neklausti“, eikite į telefono nustatymus ir suteikite reikiamus leidimus, jei norite naudotis susijusiomis funkcijomis.</string>
    <string name="set_center_info_text">Bakstelėkite ekraną, kad nustatytumėte naują centrą.</string>
    <string name="transform_info_text">Nuvilkite kraštus į naują vietą ir bakstelėkite varnelę, kad padidintumėte arba apkirptumėte paveikslėlio sritį.</string>
    <string name="cursor_draw_inactive">Perkelkite į norimą vietą ir bakstelėkite, kad pradėtumėte piešti.</string>
    <string name="cursor_draw_active">Judinkite, kad pieštumėte, ir bakstelėkite dar kartą, kad sustotumėte.</string>
    <string name="welcome_to_pocket_paint">Sveiki atvykę į Pocket Paint</string>
    <string name="intro_welcome_text">Su Pocket Paint jūsų kūrybiškumui nėra ribų. Jei esate naujas naudotojas, pradėkite įvadą arba praleiskite jį, jei Pocket Paint jau pažįstate.</string>
    <string name="intro_tool_more_information">Bakstelėkite įrankį, kad sužinotumėte daugiau</string>
    <string name="more_possibilities">Daugiau galimybių</string>
    <string name="intro_possibilities_text">Viršutine juosta atidarysite meniu ir galėsite anuliuoti arba grąžinti pakeitimus</string>
    <string name="landscape">Gulsčias režimas</string>
    <string name="intro_landscape_text">Pocket Paint palaiko piešimą ir gulsčiame režime, kad piešti būtų kuo patogiau.</string>
