    <string name="pocketpaint_jpg_message_dialog">Zë <b>shumë pak hapësirë ruajtjeje</b>. <b>Transparenca nuk ruhet</b>.</string>
    <string name="pocketpaint_png_message_dialog">Ngjeshje pa humbje. Transparenca ruhet.</string>
    <string name="pocketpaint_ora_message_dialog">Ky format ruan <b>shtresat</b>. <b>Mund të hapet nga aplikacionet që mbështesin formatin OpenRaster.</b></string>
    <string name="pocketpaint_catrobat_message_dialog">Formati i vetë Pocket Paint për imazhet. Ky format ruan komandat dhe shtresat.</string>
    <string name="permission_info_external_storage_text">Ky aplikacion ka nevojë për lejen e kërkuar që të funksionojë siç duhet. Për të ruajtur imazhe në kujtesën lokale, aplikacioni ka nevojë për qasje leximi dhe shkrimi.</string>
    <string name="permission_info_permanent_denial_text">Ky aplikacion ka nevojë për lejen e kërkuar që të funksionojë siç duhet. Për të ruajtur imazhe në kujtesën lokale, aplikacioni ka nevojë për qasje leximi dhe shkrimi. Meqë e refuzuat lejen me “Mos pyet më”, shkoni te cilësimet e telefonit dhe jepni lejet e nevojshme nëse doni të përdorni funksionet përkatëse.</string>
    <string name="set_center_info_text">Prekni ekranin për të caktuar pozicionin e ri të qendrës.</string>
    <string name="transform_info_text">Tërhiqni skajet në pozicionin e ri, pastaj prekni shenjën e miratimit për të zmadhuar ose prerë zonën e imazhit.</string>
    <string name="cursor_draw_inactive">Lëvizeni në pozicion, pastaj prekni për të filluar vizatimin.</string>
    <string name="cursor_draw_active">Tërhiqeni për të vizatuar, pastaj prekni përsëri për të ndaluar.</string>
    <string name="welcome_to_pocket_paint">Mirë se vini në Pocket Paint</string>
    <string name="intro_welcome_text">Me Pocket Paint krijimtaria juaj nuk ka kufij. Nëse jeni i ri, filloni prezantimin, ose kapërcejeni nëse e njihni tashmë Pocket Paint.</string>
    <string name="intro_tool_more_information">Prekni një mjet për më shumë informacion</string>
    <string name="more_possibilities">Më shumë mundësi</string>
    <string name="intro_possibilities_text">Përdorni shiritin e sipërm për të hapur menynë shtesë dhe për të zhbërë ose ribërë ndryshimet</string>
    <string name="landscape">Horizontale</string>
    <string name="intro_landscape_text">Pocket Paint mbështet edhe vizatimin në pozicion horizontal për t’ju dhënë përvojën më të mirë të vizatimit.</string>
    <string name="enjoy_pocket_paint">Gjithçka gati. Kënaquni me Pocket Paint.</string>
    <string name="intro_get_started">Filloni dhe krijoni një kryevepër të re.</string>
    <string name="lets_go">Fillojmë</string>
    <string name="next">Tjetër</string>
    <string name="skip">Kapërce</string>
    <string name="pocketpaint_about_title">Rreth</string>
    <string name="pocketpaint_about_content">Pocket Paint është një librari për përpunimin e imazheve që është pjesë e projektit Catrobat.\n\nCatrobat është një gjuhë programimi vizuale dhe një grup mjetesh krijuese për telefona inteligjentë.\n\nKodi burimor i Pocket Paint është i licencuar kryesisht sipas %s.\nPër hollësi mbi licencën shihni lidhjen më poshtë.</string>
    <string name="pocketpaint_about_url_license_description">Licenca e kodit burimor të Pocket Paint</string>
    <string name="pocketpaint_about_url_catrobat_description">Rreth Catrobat</string>
    <string name="pocketpaint_intro">Prezantim</string>
    <string name="pocketpaint_intro_split_screen_not_supported">Prezantimi nuk e mbështet ekranin e ndarë.</string>
    <string name="pocketpaint_overwrite_title">Të mbishkruhet skedari?</string>
    <string name="pocketpaint_overwrite">Jeni gati të mbishkruani një imazh ekzistues (këshillë: për ta ruajtur si imazh të ri, përdorni opsionin “%s”). Të ruhet gjithsesi?</string>
    <string name="pocketpaint_like_us">A ju pëlqen Pocket Paint?</string>
    <string name="pocketpaint_rate_us">Dëshironi ta vlerësoni Pocket Paint?</string>
    <string name="pocketpaint_feedback">Na vjen keq që e dëgjojmë këtë. Nëse doni të ndani përvojën tuaj me ne, ju lutemi shkruani në contact@catrobat.org</string>
