    <string name="pocketpaint_jpg_message_dialog">Gumagamit ng <b>pinakakaunting storage</b>. <b>Hindi naiingatan ang transparency</b>.</string>
    <string name="pocketpaint_png_message_dialog">Lossless na compression. Naiingatan ang transparency.</string>
    <string name="pocketpaint_ora_message_dialog">Naaalala ng format na ito ang mga <b>layer</b>. <b>Mabubuksan ito ng mga app na sumusuporta sa format na OpenRaster.</b></string>
    <string name="pocketpaint_catrobat_message_dialog">Ang sariling format ng imahe ng Pocket Paint. Naaalala ng format na ito ang mga command at layer.</string>
    <string name="permission_info_external_storage_text">Kailangan ng app na ito ang hinihinging pahintulot para gumana nang maayos. Para makapag-save ng mga imahe sa lokal na memory, kailangan ng app ng access para magbasa at magsulat dito.</string>
    <string name="permission_info_permanent_denial_text">Kailangan ng app na ito ang hinihinging pahintulot para gumana nang maayos. Para makapag-save ng mga imahe sa lokal na memory, kailangan ng app ng access para magbasa at magsulat dito. Dahil tinanggihan mo ang pahintulot gamit ang “Huwag nang itanong ulit”, pumunta sa mga setting ng iyong telepono at ibigay ang mga kinakailangang pahintulot kung gusto mong gamitin ang mga kaugnay na function.</string>
    <string name="set_center_info_text">I-tap ang screen para itakda ang bagong posisyon ng gitna.</string>
    <string name="transform_info_text">I-drag ang mga gilid sa bago nilang posisyon, at i-tap ang checkmark para palakihin o i-crop ang lugar ng imahe.</string>
    <string name="cursor_draw_inactive">Ilipat sa gustong posisyon, at i-tap para magsimulang magpinta.</string>
    <string name="cursor_draw_active">Ilipat para gumuhit, at i-tap ulit para huminto.</string>
