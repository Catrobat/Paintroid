<network-security-config>
    <!-- Base configuration for all connections -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust system certificate authorities -->
            <certificates src="system" />
            <!-- Optionally trust user-added CAs for debugging -->
            <!-- <certificates src="user" /> -->
        </trust-anchors>
    </base-config>

    <!-- Debug configuration (only active in debug builds) -->
    <debug-overrides>
        <trust-anchors>
            <!-- Trust system CAs -->
            <certificates src="system" />
            <!-- Trust user-added CAs for development/debugging -->
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

    <!-- 
        Domain-specific configurations can be added here
        Example for certificate pinning (uncomment and configure as needed):
        
        <domain-config cleartextTrafficPermitted="false">
            <domain includeSubdomains="true">api.catrobat.org</domain>
            <pin-set expiration="2026-01-01">
                <pin digest="SHA-256">base64EncodedPublicKeyHash==</pin>
                <pin digest="SHA-256">backupKeyHash==</pin>
            </pin-set>
        </domain-config>
    -->
</network-security-config>
