    <string name="pocketpaint_overwrite_title">Ghi đè tệp?</string>
    <string name="pocketpaint_overwrite">Bạn sắp ghi đè một hình ảnh hiện có (gợi ý: để lưu thành hình ảnh mới, hãy dùng tùy chọn “%s”). Vẫn lưu?</string>
