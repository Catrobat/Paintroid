    <string name="pocketpaint_jpg_message_dialog">Chiếm <b>ít dung lượng nhất</b>. <b>Không giữ độ trong suốt</b>.</string>
    <string name="pocketpaint_png_message_dialog">Nén không mất dữ liệu. Độ trong suốt được giữ nguyên.</string>
    <string name="pocketpaint_ora_message_dialog">Định dạng này lưu lại các <b>lớp</b>. <b>Có thể mở bằng các ứng dụng hỗ trợ định dạng OpenRaster.</b></string>
    <string name="pocketpaint_catrobat_message_dialog">Định dạng hình ảnh riêng của Pocket Paint. Định dạng này lưu lại các lệnh và các lớp.</string>
    <string name="permission_info_external_storage_text">Ứng dụng cần quyền được yêu cầu để hoạt động bình thường. Để lưu hình ảnh vào bộ nhớ trong, ứng dụng cần quyền đọc và ghi vào đó.</string>
    <string name="permission_info_permanent_denial_text">Ứng dụng cần quyền được yêu cầu để hoạt động bình thường. Để lưu hình ảnh vào bộ nhớ trong, ứng dụng cần quyền đọc và ghi vào đó. Vì bạn đã từ chối quyền với tùy chọn “Không hỏi lại”, hãy vào phần cài đặt của điện thoại và cấp các quyền cần thiết nếu bạn muốn dùng các chức năng liên quan.</string>
    <string name="set_center_info_text">Nhấn vào màn hình để xác định vị trí tâm mới.</string>
    <string name="transform_info_text">Kéo các cạnh đến vị trí mới, rồi nhấn vào dấu tích để mở rộng hoặc cắt xén vùng hình ảnh.</string>
    <string name="cursor_draw_inactive">Di chuyển đến vị trí mong muốn, rồi nhấn để bắt đầu vẽ.</string>
    <string name="cursor_draw_active">Di chuyển để vẽ, rồi nhấn lại để dừng vẽ.</string>
    <string name="welcome_to_pocket_paint">Chào mừng bạn đến với Pocket Paint</string>
    <string name="intro_welcome_text">Với Pocket Paint, sự sáng tạo của bạn không có giới hạn. Nếu bạn là người mới, hãy bắt đầu phần giới thiệu, hoặc bỏ qua nếu bạn đã quen với Pocket Paint.</string>
    <string name="intro_tool_more_information">Nhấn vào một công cụ để xem thêm thông tin</string>
