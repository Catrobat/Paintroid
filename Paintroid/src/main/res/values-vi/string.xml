    <string name="help_content_undo">Nhấn để hoàn tác thao tác trước đó.</string>
    <string name="help_content_redo">Nhấn để làm lại thao tác đã hoàn tác.</string>
    <string name="help_content_fill">Nhấn vào hình ảnh để tô một vùng bằng màu đã chọn.</string>
    <string name="help_content_cursor">Đặt con trỏ ở nơi bạn muốn vẽ. Nhấn để kích hoạt con trỏ. Di chuyển ngón tay để vẽ. Nhấn lại để tắt.</string>
    <string name="help_content_transform">Xoay, lật, cắt xén hoặc thay đổi kích thước hình ảnh.</string>
    <string name="help_content_clipboard">Di chuyển và thay đổi kích thước hình chữ nhật để phủ vùng bạn muốn đóng dấu. Nhấn Sao chép hoặc Cắt để chọn vùng. Di chuyển vùng đó rồi nhấn Dán để đóng dấu.</string>
    <string name="help_content_import_png">Nhập một hình ảnh từ thư viện ảnh vào bảng nhớ tạm.</string>
    <string name="help_content_line">Vẽ một đường thẳng.</string>
    <string name="help_content_text">Viết văn bản và định dạng nó. Sau đó thay đổi kích thước hộp văn bản. Nhấn vào dấu tích để chèn văn bản vào hình ảnh.</string>
    <string name="help_content_shape">Chọn một hình dạng và nhấn vào dấu tích để chèn hình đó.</string>
    <string name="help_content_layer">Tạo lớp mới hoặc chỉnh sửa các lớp hiện có.</string>
