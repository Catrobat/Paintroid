    <string name="pocketpaint_about_title">Kuhusu</string>
    <string name="pocketpaint_about_content">Pocket Paint ni maktaba ya kuhariri picha iliyo sehemu ya mradi wa Catrobat.\n\nCatrobat ni lugha ya programu inayoonekana na seti ya zana za ubunifu kwa simu janja.\n\nMsimbo chanzo wa Pocket Paint kwa kiasi kikubwa umepewa leseni chini ya %s.\nKwa maelezo kamili ya leseni, angalia kiungo kilicho hapa chini.</string>
    <string name="pocketpaint_about_url_license_description">Leseni ya msimbo chanzo wa Pocket Paint</string>
    <string name="pocketpaint_about_url_catrobat_description">Kuhusu Catrobat</string>
    <string name="pocketpaint_intro">Utangulizi</string>
