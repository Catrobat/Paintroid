    <string name="pocketpaint_jpg_message_dialog">Ó ń gba <b>àyè ìpamọ́ tó kéré jùlọ</b>. <b>A kò ní rántí ìhànhàn</b>.</string>
    <string name="pocketpaint_png_message_dialog">Ìfúnpọ̀ láìsí àdánù. A ń pa ìhànhàn mọ́.</string>
    <string name="pocketpaint_ora_message_dialog">Ọ̀nà yìí ń rántí <b>àwọn ìpele</b>. <b>Àwọn áàpù tó ń ṣàtìlẹ́yìn ọ̀nà OpenRaster lè ṣí i.</b></string>
    <string name="pocketpaint_catrobat_message_dialog">Ọ̀nà àwòrán ti Pocket Paint fúnra rẹ̀. Ọ̀nà yìí ń rántí àwọn àṣẹ àti àwọn ìpele.</string>
    <string name="permission_info_external_storage_text">Áàpù yìí nílò ìyọ̀ǹda tí a béèrè láti ṣiṣẹ́ dáadáa. Láti fi àwọn àwòrán pamọ́ sí ìrántí agbègbè, áàpù náà nílò àǹfààní láti kà àti láti kọ sí i.</string>
    <string name="permission_info_permanent_denial_text">Áàpù yìí nílò ìyọ̀ǹda tí a béèrè láti ṣiṣẹ́ dáadáa. Láti fi àwọn àwòrán pamọ́ sí ìrántí agbègbè, áàpù náà nílò àǹfààní láti kà àti láti kọ sí i. Níwọ̀n ìgbà tí o ti kọ ìyọ̀ǹda pẹ̀lú “Má ṣe béèrè mọ́”, jọ̀wọ́ lọ sí ètò fóònù rẹ kí o sì fún un ní àwọn ìyọ̀ǹda tó yẹ tí o bá fẹ́ lo àwọn iṣẹ́ tó jẹ mọ́ ọn.</string>
    <string name="set_center_info_text">Tẹ ojú ìbojú láti ṣètò ipò àárín tuntun.</string>
    <string name="transform_info_text">Fa àwọn etí lọ sí ipò wọn tuntun, lẹ́yìn náà tẹ àmì ìfọwọ́sí láti mú agbègbè àwòrán tóbi tàbí láti gé e.</string>
    <string name="cursor_draw_inactive">Gbé e lọ sí ipò tí o fẹ́, lẹ́yìn náà tẹ̀ ẹ́ láti bẹ̀rẹ̀ sí í yà.</string>
