    <string name="welcome_to_pocket_paint">Káàbọ̀ sí Pocket Paint</string>
    <string name="intro_welcome_text">Pẹ̀lú Pocket Paint, kò sí ààlà fún ìṣẹ̀dá rẹ. Tí o bá jẹ́ ẹni tuntun, bẹ̀rẹ̀ ìfihàn, tàbí fò ó tí o bá ti mọ Pocket Paint tẹ́lẹ̀.</string>
