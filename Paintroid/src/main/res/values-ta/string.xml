    <string name="help_content_brush">வண்ணத்தை அல்லது தூரிகையின் அளவை மாற்ற கீழ்ப் பட்டியில் உள்ள குறியீடுகளைத் தட்டவும்.</string>
    <string name="help_content_watercolor">தூரிகையைப் போன்றது, ஆனால் நீர்வண்ண விளைவுடன். வண்ண மெனுவில் உள்ள ஸ்லைடர் மூலம் தூரிகையின் வலிமையையும் மாற்றலாம்.</string>
    <string name="help_content_eyedropper">ஒரு வண்ணத்தைத் தேர்ந்தெடுக்க படத்தைத் தட்டவும்.</string>
    <string name="help_content_undo">முந்தைய செயலைச் செயல்தவிர்க்கத் தட்டவும்.</string>
    <string name="help_content_redo">செயல்தவிர்த்த செயலை மீண்டும் செய்யத் தட்டவும்.</string>
    <string name="help_content_fill">தேர்ந்தெடுத்த வண்ணத்தால் ஒரு பகுதியை நிரப்ப படத்தைத் தட்டவும்.</string>
    <string name="help_content_cursor">நீங்கள் வரைய விரும்பும் இடத்தில் கர்சரை வைக்கவும். கர்சரை இயக்கத் தட்டவும். வரைய விரலை நகர்த்தவும். முடக்க மீண்டும் தட்டவும்.</string>
    <string name="help_content_transform">படத்தைச் சுழற்றவும், புரட்டவும், செதுக்கவும் அல்லது அளவை மாற்றவும்.</string>
    <string name="help_content_clipboard">நீங்கள் முத்திரையிட விரும்பும் பகுதியை மறைக்கும்படி செவ்வகத்தை நகர்த்தி அளவை மாற்றவும். பகுதியைத் தேர்ந்தெடுக்க நகலெடு அல்லது வெட்டு என்பதைத் தட்டவும். அதை நகர்த்தி, முத்திரையிட ஒட்டு என்பதைத் தட்டவும்.</string>
    <string name="help_content_import_png">கேலரியிலிருந்து ஒரு படத்தை கிளிப்போர்டுக்கு இறக்கவும்.</string>
    <string name="help_content_line">ஒரு நேர்கோட்டை வரையவும்.</string>
    <string name="help_content_text">உரையை எழுதி வடிவமைக்கவும். பின்னர் உரைப் பெட்டியின் அளவை மாற்றவும். உரையைப் படத்தில் செருக டிக் குறியைத் தட்டவும்.</string>
    <string name="help_content_shape">ஒரு வடிவத்தைத் தேர்ந்தெடுத்து, அதைச் செருக டிக் குறியைத் தட்டவும்.</string>
    <string name="help_content_layer">புதிய அடுக்குகளை உருவாக்கவும் அல்லது ஏற்கனவே உள்ளவற்றை மாற்றவும்.</string>
    <string name="help_content_color_chooser">ஒரு வண்ணத்தைத் தேர்ந்தெடுக்கவும் அல்லது சரிசெய்யவும்.</string>
