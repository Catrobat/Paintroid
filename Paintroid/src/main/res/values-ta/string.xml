    <string name="bottom_navigation_item">கீழ் வழிசெலுத்தல் உருப்படி</string>
    <string name="intro_bottom_navigation_tools_description">நீங்கள் பயன்படுத்த விரும்பும் கருவிக்கு மாறவும்.</string>
    <string name="intro_bottom_navigation_current_description">தற்போது பயன்படுத்தப்படும் கருவியைக் காட்டி அதன் விருப்பங்களைத் திறக்கும்.</string>
    <string name="intro_bottom_navigation_color_description">தற்போது பயன்படுத்தப்படும் வண்ணத்தைக் காட்டி வண்ணத் தேர்வியைத் திறக்கும்.</string>
    <string name="intro_bottom_navigation_layers_description">அடுக்கு மெனுவைத் திறந்து உங்கள் அடுக்குகளை நிர்வகிக்க உதவும்.</string>
    <string name="pocketpaint_tool_icon_description">தற்போதைய கருவியின் ஐகான்</string>
    <string name="dialog_scale_title">படம் ஏற்ற முடியாத அளவுக்குப் பெரியது</string>
    <string name="dialog_scale_message">படம் ஏற்ற முடியாத அளவுக்குப் பெரியது. படத்தைத் தானாகச் சிறிதாக்க சரி என்பதைத் தட்டவும்.</string>
    <string name="zoom_window_description">வரைதல் பரப்பின் பெரிதாக்கப்பட்ட பகுதியைக் காட்டும்</string>
