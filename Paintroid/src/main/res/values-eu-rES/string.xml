    <string name="pocketpaint_ora_message_dialog">Formatu honek <b>geruzak</b> gordetzen ditu. <b>OpenRaster formatua onartzen duten aplikazioekin ireki daiteke.</b></string>
    <string name="pocketpaint_catrobat_message_dialog">Pocket Paint-en berezko irudi-formatua. Formatu honek komandoak eta geruzak gordetzen ditu.</string>
    <string name="permission_info_external_storage_text">Aplikazio honek eskatutako baimena behar du behar bezala funtzionatzeko. Irudiak gailuaren memorian gordetzeko, irakurtzeko eta idazteko sarbidea behar du.</string>
    <string name="permission_info_permanent_denial_text">Aplikazio honek eskatutako baimena behar du behar bezala funtzionatzeko. Irudiak gailuaren memorian gordetzeko, irakurtzeko eta idazteko sarbidea behar du. Baimena “Ez galdetu berriro” aukerarekin ukatu duzunez, joan telefonoaren ezarpenetara eta eman beharrezko baimenak, lotutako funtzioak erabili nahi badituzu.</string>
    <string name="set_center_info_text">Sakatu pantaila erdigunearen posizio berria zehazteko.</string>
    <string name="transform_info_text">Arrastatu ertzak posizio berrira, eta sakatu egiaztatze-marka irudiaren eremua handitzeko edo mozteko.</string>
