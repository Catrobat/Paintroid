    <string name="more_possibilities">Meer mogelijkheden</string>
    <string name="intro_possibilities_text">Gebruik de bovenste balk om het menu te openen en om wijzigingen ongedaan te maken of opnieuw uit te voeren</string>
    <string name="landscape">Liggend</string>
